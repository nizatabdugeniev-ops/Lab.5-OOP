<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Лабораторная работа №5 — Мини-калькулятор</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #38bdf8;
      --accent-2: #22c55e;
      --danger: #f87171;
      --text: #e2e8f0;
      --muted: #94a3b8;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", system-ui, sans-serif;
      background:
        radial-gradient(circle at top right, #1d4ed8 0%, transparent 40%),
        radial-gradient(circle at bottom left, #0ea5e9 0%, transparent 35%),
        var(--bg);
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .app {
      width: min(480px, 100%);
      background: color-mix(in srgb, var(--card) 92%, transparent);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(10px);
    }

    h1 { margin: 0 0 6px; font-size: 1.45rem; }

    .subtitle {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .fields { display: grid; gap: 12px; margin-bottom: 16px; }

    label {
      display: block;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 6px;
    }

    input[type="number"] {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: #0b1220;
      color: var(--text);
      font-size: 1.05rem;
      outline: none;
    }

    input[type="number"]:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }

    .ops {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-bottom: 16px;
    }

    button {
      border: 0;
      border-radius: 12px;
      padding: 12px 0;
      font-size: 1.15rem;
      font-weight: 700;
      cursor: pointer;
      background: #334155;
      color: white;
    }

    button:hover { background: #475569; }

    .result-box {
      background: #0b1220;
      border-radius: 14px;
      padding: 16px;
      min-height: 76px;
    }

    .result-label {
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 6px;
    }

    #result {
      font-size: 1.4rem;
      font-weight: 700;
      word-break: break-word;
    }

    #result.error { color: var(--danger); }
    #result.ok { color: var(--accent-2); }

    .hint {
      margin-top: 14px;
      font-size: 0.8rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <main class="app">
    <h1>Мини-калькулятор</h1>
    <p class="subtitle">Лабораторная работа №5 • JavaScript • DOM</p>

    <div class="fields">
      <div>
        <label for="num1">Первое число</label>
        <input id="num1" type="number" step="any" placeholder="Например, 12" />
      </div>
      <div>
        <label for="num2">Второе число</label>
        <input id="num2" type="number" step="any" placeholder="Например, 4" />
      </div>
    </div>

    <div class="ops">
      <button type="button" data-op="+">+</button>
      <button type="button" data-op="-">−</button>
      <button type="button" data-op="*">×</button>
      <button type="button" data-op="/">÷</button>
    </div>

    <div class="result-box">
      <div class="result-label">Результат</div>
      <div id="result">Введите числа и выберите операцию</div>
    </div>

    <p class="hint">Результат выводится на странице через изменение DOM-элемента #result.</p>
  </main>

  <script>
    const num1Input = document.getElementById("num1");
    const num2Input = document.getElementById("num2");
    const resultEl = document.getElementById("result");
    const buttons = document.querySelectorAll("button[data-op]");

    function showResult(text, type) {
      resultEl.textContent = text;
      resultEl.classList.remove("ok", "error");
      if (type) resultEl.classList.add(type);
    }

    function calculate(op) {
      const a = Number(num1Input.value);
      const b = Number(num2Input.value);

      if (num1Input.value.trim() === "" || num2Input.value.trim() === "") {
        showResult("Ошибка: заполните оба поля.", "error");
        return;
      }

      if (Number.isNaN(a) || Number.isNaN(b)) {
        showResult("Ошибка: введите корректные числа.", "error");
        return;
      }

      let value;
      switch (op) {
        case "+":
          value = a + b;
          break;
        case "-":
          value = a - b;
          break;
        case "*":
          value = a * b;
          break;
        case "/":
          if (b === 0) {
            showResult("Ошибка: деление на ноль невозможно.", "error");
            return;
          }
          value = a / b;
          break;
        default:
          showResult("Неизвестная операция.", "error");
          return;
      }

      const pretty = Number.isInteger(value) ? String(value) : String(Number(value.toFixed(8)));
      const sign = op === "*" ? "×" : op === "/" ? "÷" : op === "-" ? "−" : "+";
      showResult(`${a} ${sign} ${b} = ${pretty}`, "ok");
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => calculate(btn.dataset.op));
    });
  </script>
</body>
</html>
